    {
      "id": "get-paid-lite-7",
      "name": "Pick Invoices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1150,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function isoDate(raw){const s=String(raw??'').trim();if(!/^\\d{4}-\\d{2}-\\d{2}$/.test(s))return '';const t=Date.parse(s+'T00:00:00Z');return Number.isFinite(t)&&new Date(t).toISOString().slice(0,10)===s?s:'';}\nfunction cairoDate(now,tz){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(now);const value=k=>parts.find(p=>p.type===k).value;return value('year')+'-'+value('month')+'-'+value('day');}\nconst c=$('Config').first().json;\nif(typeof c.DRY_RUN!=='boolean'||!Number.isInteger(c.MAX_PER_RUN)||c.MAX_PER_RUN<1)throw new Error('Invalid Config: DRY_RUN or MAX_PER_RUN');\nif(c.DRY_RUN===false){for(const field of ['BUSINESS_NAME','PAYMENT_DETAILS','OWNER_TELEGRAM_CHAT_ID','SHEET_ID']){if(String(c[field]??'').includes('REPLACE_'))throw new Error('Unresolved placeholder: '+field);}}\nconst today=Date.parse(cairoDate(new Date(),c.TIMEZONE)+'T00:00:00Z');const selected=[],seen=new Set();let invalid=0;\nfor(const item of $input.all()){\n const r=item.json;if(!Object.values(r).some(v=>v!==''&&v!==null&&v!==undefined))continue;\n const status=String(r.status||'').trim().toLowerCase();if(status==='paid'||status==='disputed')continue;\n const amount=Number(r.amount),paid=Number(r.amount_paid||0),due=isoDate(r.due_date),email=String(r.email||'').trim(),number=String(r.invoice_no||'').trim();\n if(status!=='open'||!number||!Number.isFinite(amount)||!Number.isFinite(paid)||!due||!/^[^\\s@,;]+@[^\\s@,;]+\\.[^\\s@,;]+$/.test(email)){invalid++;continue;}\n const amount_due=Math.round((amount-paid)*100)/100;if(amount_due<=0)continue;\n const days_overdue=Math.floor((today-Date.parse(due+'T00:00:00Z'))/86400000);if(days_overdue<c.STAGE_DAYS.gentle)continue;\n const stage=days_overdue>=c.STAGE_DAYS.escalate?4:days_overdue>=c.STAGE_DAYS.firm?3:days_overdue>=c.STAGE_DAYS.reminder?2:1;\n if(Number(r.last_reminder_stage||0)>=stage||seen.has(number))continue;seen.add(number);\n selected.push({invoice_no:number,customer_name:String(r.customer_name||''),email,language:String(r.language||'en').toLowerCase()==='ar'?'ar':'en',amount_due,currency:String(r.currency||''),due_date:due,status:'open',stage,days_overdue,body:stage===4?'Owner review required: '+number+'; '+String(r.customer_name||'')+'; '+amount_due+' '+String(r.currency||'')+'; due '+due:'',processed:true});\n}\nconst limited=selected.slice(0,c.MAX_PER_RUN),deferred=Math.max(0,selected.length-limited.length);\nreturn limited.length?limited.map(i=>({json:{...i,skipped_invalid_rows:invalid,deferred}})):[{json:{no_invoice:true,processed:false,action:'next',status:invalid?'skipped_invalid':'no_work',skipped_invalid_rows:invalid,deferred:0}}];"
      }
    },
