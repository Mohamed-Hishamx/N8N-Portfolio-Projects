    {
      "id": "get-paid-lite-15",
      "name": "Fresh Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2530,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base=$('Invoice Loop').item.json;let i=base;\nif(base.stage!==4){try{i=$('Validate').item.json;}catch{}}\nconst c=$('Config').first().json,r=$json;\nconst residual=Math.round((Number(r.amount)-Number(r.amount_paid||0))*100)/100;\nconst same=!r.error&&String(r.invoice_no)===i.invoice_no&&String(r.status||'').trim().toLowerCase()==='open'&&Number.isFinite(residual)&&residual===i.amount_due;\nconst invalidDraft=i.stage!==4&&!i.draft_valid;\nif(invalidDraft||r.error)return {json:{...i,action:'next',status:'failed',processed:true,reason:invalidDraft?'Fallback message failed validation':'Invoice re-read failed'}};\nif(!same)return {json:{...i,action:'next',status:'skipped',processed:true,reason:'Invoice missing, no longer open, or amount changed'}};\nreturn {json:{...i,action:i.stage===4||c.DRY_RUN?'owner':'send'}};"
      }
    },
