    {
      "id": "get-paid-lite-13",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2070,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const i=$('Invoice Loop').item.json,c=$('Config').first().json;\nconst a=String(i.amount_due)+' '+i.currency;\nconst templates={en:{1:()=> 'Hello '+i.customer_name+', a gentle reminder from '+c.BUSINESS_NAME+'. Invoice '+i.invoice_no+' for '+a+' was due on '+i.due_date+'. Payment details: '+c.PAYMENT_DETAILS+'. Thank you.',2:()=> 'Hello '+i.customer_name+', a payment reminder from '+c.BUSINESS_NAME+'. Invoice '+i.invoice_no+' for '+a+' was due on '+i.due_date+'. Please arrange payment using: '+c.PAYMENT_DETAILS+'. Thank you for your cooperation.',3:()=> 'Hello '+i.customer_name+', please arrange payment to '+c.BUSINESS_NAME+'. Invoice '+i.invoice_no+' for '+a+' was due on '+i.due_date+'. Payment details: '+c.PAYMENT_DETAILS+'. Please let us know when payment is arranged.'},ar:{1:()=> 'أهلاً '+i.customer_name+'، تذكير بسيط من '+c.BUSINESS_NAME+'. الفاتورة '+i.invoice_no+' بمبلغ '+a+' مستحقة بتاريخ '+i.due_date+'. تفاصيل الدفع: '+c.PAYMENT_DETAILS+'. شكراً لتعاونكم.',2:()=> 'أهلاً '+i.customer_name+'، حابين نفكركم من '+c.BUSINESS_NAME+'. الفاتورة '+i.invoice_no+' بمبلغ '+a+' مستحقة بتاريخ '+i.due_date+'. برجاء ترتيب الدفع من خلال: '+c.PAYMENT_DETAILS+'. شكراً لتعاونكم.',3:()=> 'أهلاً '+i.customer_name+'، برجاء ترتيب سداد المستحق لصالح '+c.BUSINESS_NAME+'. الفاتورة '+i.invoice_no+' بمبلغ '+a+' مستحقة بتاريخ '+i.due_date+'. تفاصيل الدفع: '+c.PAYMENT_DETAILS+'. ياريت تبلغونا بموعد ترتيب الدفع.'}};\nfunction valid(m){return m&&typeof m.body==='string'&&m.body.trim().length>0&&m.body.length<700&&[i.invoice_no,String(i.amount_due),c.PAYMENT_DETAILS].every(v=>m.body.includes(v))&&typeof m.subject==='string'&&m.subject.trim().length>0;}\nlet message=$json.error?null:($json.output||$json.text||$json);try{if(typeof message==='string')message=JSON.parse(message);}catch{message=null;}\nconst fallback_used=!valid(message);if(fallback_used)message={subject:(i.language==='ar'?'تذكير بالفاتورة ':'Invoice reminder ')+i.invoice_no,body:templates[i.language]?.[i.stage]?.()||''};\nreturn {json:{...i,...message,draft_valid:!!valid(message),fallback_used}};"
      }
    },
