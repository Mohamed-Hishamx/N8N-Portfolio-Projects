      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const body = $json;\nlet digits = (body['Phone'] || '').toString().replace(/\\D/g, '');\nif (digits.length === 10) digits = '1' + digits;\n\nconst companySize = (body['Company Size'] || '').toString();\nconst budget = (body['Monthly Marketing Budget'] || '').toString();\n\nconst isEnterprise = companySize === '200+' || budget === '20k+';\n\nreturn { json: {\n  execId: $execution.id,\n  firstName: (body['First Name'] || '').toString().trim(),\n  lastName: (body['Last Name'] || 'Unknown').toString().trim(),\n  email: (body['Email'] || '').toString().trim().toLowerCase(),\n  phone: digits ? '+' + digits : '',\n  company: (body['Company'] || 'Unknown').toString().trim(),\n  industry: (body['Industry'] || '').toString(),\n  challenge: (body['Biggest Challenge'] || '').toString(),\n  companySize,\n  budget,\n  crmTarget: isEnterprise ? 'salesforce' : 'hubspot',\n  source: 'strategy-form',\n  timestamp: new Date().toISOString(),\n  rawPayload: body\n} };"
      },
