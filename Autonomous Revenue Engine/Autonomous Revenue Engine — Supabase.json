    {
      "parameters": {
        "jsCode": "const vapiMsg = $node['Event Type Router'].json.body.message;\nlet llm;\ntry { llm = JSON.parse($json.choices[0].message.content); }\ncatch (e) { llm = { qualificationScore: 0, sentiment: 'neutral', budget: 'unknown', timeline: 'unknown', painPoints: [], nextAction: 'manual review', summary: 'LLM output parse failed', keyInsights: [] }; }\nconst call = vapiMsg.call || {};\nconst meta = call.metadata || {};\nconst crmRef = meta.crmRef || '';\nconst crmRecordId = crmRef.indexOf(':') >= 0 ? crmRef.split(':')[1] : '';\nreturn { json: {\n  qualificationScore: parseInt(llm.qualificationScore, 10) || 0,\n  sentiment: llm.sentiment || 'neutral',\n  budget: llm.budget || 'unknown',\n  timeline: llm.timeline || 'unknown',\n  painPoints: Array.isArray(llm.painPoints) ? llm.painPoints : [],\n  nextAction: llm.nextAction || '',\n  summary: (llm.summary || '').toString().substring(0, 1000),\n  keyInsights: Array.isArray(llm.keyInsights) ? llm.keyInsights : [],\n  callId: call.id || '',\n  crmRef,\n  crmTarget: meta.crmTarget || '',\n  crmRecordId,\n  leadName: (call.customer && call.customer.name) || meta.leadName || '',\n  leadEmail: meta.leadEmail || '',\n  transcript: vapiMsg.transcript || (vapiMsg.artifact && vapiMsg.artifact.transcript) || '',\n  recordingUrl: vapiMsg.recordingUrl || (vapiMsg.artifact && vapiMsg.artifact.recordingUrl) || '',\n  durationSeconds: parseInt(call.durationSeconds || vapiMsg.durationSeconds || 0, 10),\n  analyzedAt: new Date().toISOString()\n} };"
      },
