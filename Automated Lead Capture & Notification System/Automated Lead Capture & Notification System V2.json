        "jsCode": "const lead = $node['Extract, Validate & Score Lead1'].json;\nconst searchResults = items;\n\nconst isDuplicate = searchResults.length > 0 && searchResults[0].json.id;\nconst existingId  = isDuplicate ? searchResults[0].json.id : null;\n\nitems[0].json = {\n  ...lead,\n  is_duplicate: isDuplicate,\n  existing_record_id: existingId,\n  airtable_action: isDuplicate ? 'update' : 'create'\n};\n\nreturn items;"
