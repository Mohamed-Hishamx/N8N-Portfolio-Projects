    {
      "parameters": {
        "jsCode": "const fields = items[0].json.body?.data?.fields || [];\n\nconst getField = (label) => {\n  const f = fields.find(f => f.label === label);\n  return f ? String(f.value || '').trim() : '';\n};\n\nconst name    = getField('Name')             || items[0].json.name    || '';\nconst email   = getField('What is your Email') || items[0].json.email   || '';\nconst phone   = getField('Phone Number')     || items[0].json.phone   || '';\nconst message = getField('Leave a Message')  || items[0].json.message || '';\nconst source  = items[0].json.body?.data?.formName || 'Website Form';\n\n// Validate\nif (!name)              throw new Error('Lead rejected: missing name');\nif (!email && !phone)   throw new Error('Lead rejected: missing email and phone');\n\n// Score\nlet score = 0;\nif (phone)                  score += 30;\nif (email)                  score += 20;\nif (message.length > 80)    score += 30;\nif (message.length > 20)    score += 10;\nif (message.length > 0)     score += 10;\n\nconst tier = score >= 70 ? 'High Priority' : score >= 40 ? 'Medium Priority' : 'Low Priority';\n\nitems[0].json.full_name   = name;\nitems[0].json.email       = email;\nitems[0].json.phone       = phone;\nitems[0].json.message     = message;\nitems[0].json.source      = source;\nitems[0].json.score       = score;\nitems[0].json.tier        = tier;\nitems[0].json.status      = 'New';\nitems[0].json.received_at = new Date().toISOString();\n\nreturn items;"
      },
